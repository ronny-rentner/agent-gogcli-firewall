# Copy to gog.env (chmod 0600, owner-only; the agent account must not be able to read it).
# This file is runtime config, not policy. The boundaries live elsewhere: the command each
# gog-*-forced wrapper hardcodes, the locked flags and command rules baked into the
# gog-readonly-locked / gog-agent-safe-locked binaries, and the bwrap write confinement.
# Settings here are defaults a command line could override, so nothing safety-relevant
# belongs in this file.

# Required for gogcli encrypted file keyring on headless Linux.
GOG_KEYRING_BACKEND=file
GOG_KEYRING_PASSWORD=replace-with-long-random-password

# Keyring + OAuth client credentials live under this root (data/keyring, data/credentials.json).
# data/keyring is the only auth path the wrappers bind writable under bwrap (the file keyring
# opens .lock O_RDWR even for reads).
GOG_DATA_DIR=./data

# gog state root; downloaded attachments default to config/gmail-attachments, the only other
# bwrap-writable path. A dedicated subdir keeps wrappers, binaries, and this file read-only.
GOG_CONFIG_DIR=./config

# Pin the account so wrappers don't depend on aliases/defaults.
GOG_ACCOUNT=your.gmail.address@gmail.com

# Max raw attachment bytes that --inline embeds as base64. 64 MiB sits above Gmail's 50 MB ceiling
# so any deliverable attachment inlines (the agent cannot read files gog writes to disk).
GOG_GMAIL_INLINE_MAX_BYTES=67108864

# List attachment metadata in search results, and reference attachments by a stable 0-based
# index instead of the long opaque attachmentId (compact, and downloadable by that index).
GOG_GMAIL_INCLUDE_ATTACHMENTS=1
GOG_GMAIL_USE_INDEXED_ATTACHMENT_IDS=1

# Reply/draft replies default to the verified send-as alias the original was addressed
# to (applies to reply/forward/drafts create/update; ignored where the flag does not exist).
GOG_GMAIL_AUTO_FROM_ADDRESSED_ALIAS=1
